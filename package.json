{
  "name": "ai-music-video-maker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Agent-mediated LAN music-video studio with generation, frame-exact editing and retained provenance.",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:list": "vitest list --no-staticParse --json=/dev/stdout",
    "test": "vitest run",
    "test:live:list": "vitest list --config vitest.live.config.ts --no-staticParse --json=/dev/stdout",
    "test:live": "vitest run --config vitest.live.config.ts",
    "build": "vite build",
    "dev": "vite",
    "start": "node apps/server/src/main.ts"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@fastify/static": "10.1.7",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.7",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "license": "MIT"
}
