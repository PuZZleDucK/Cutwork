{
  "name": "ai-music-video-maker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Slice-1 contract foundation in progress; no runnable studio UI yet.",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:list": "vitest list --no-staticParse --json",
    "test": "vitest run",
    "test:live:list": "vitest list --config vitest.live.config.ts --no-staticParse --json",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
